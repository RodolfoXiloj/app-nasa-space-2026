# Copiar a .env (que NO se sube) y llenar solo en la máquina local.
# El sitio desplegado no necesita ninguna de estas claves.

# 1 = el pipeline puede usar la red para bajar datos. Sin esto, todo se lee de data/cache/.
MILPA_ONLINE=0

# FIRMS: clave gratis por correo en https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Solo hace falta para detecciones recientes (2026). El histórico por país se baja sin clave.
FIRMS_MAP_KEY=

# Earthdata Login (https://urs.earthdata.nasa.gov/) con la aplicación AppEEARS autorizada.
# Para SMAP numérico (SPL3SMP_E, SPL4SMGP) y NDVI de respaldo por AppEEARS.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Opcional: LLM para reescribir textos al exportar. Sin clave se usan plantillas.
LLM_API_KEY=
